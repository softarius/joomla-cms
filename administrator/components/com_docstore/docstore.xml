<?xml version="1.0" encoding="utf-8"?>
<extension type="component" version="4.0" method="upgrade">
    <name>com_docstore</name>
    <creationDate>2023-12-06</creationDate>
    <copyright>2023 yushinin</copyright>
    <license>GNU General Public License version 2 or later; see LICENSE.txt</license>
    <author>yushinin</author>
    <authorEmail>yushinins@mail.ru</authorEmail>
    <authorUrl>http://</authorUrl>
    <version>0.6.0</version>
    <description>COM_DOCSTORE_XML_DESCRIPTION</description>
    <namespace path="src">Softarius\Component\Docstore</namespace>
    
    
    
    <install> 
        <sql>
            <file driver="mysql" charset="utf8">sql/install.mysql.utf8.sql</file>
            <file driver="postgresql" charset="utf8">sql/install.postgresql.utf8.sql</file>
        </sql>
    </install>
    <update> 
        <schemas>
            <schemapath type="mysql">sql/updates</schemapath>
        </schemas>
    </update>
    <uninstall> 
        <sql>
            <file driver="mysql" charset="utf8">sql/uninstall.mysql.utf8.sql</file>
            <file driver="postgresql" charset="utf8">sql/uninstall.postgresql.utf8.sql</file>
        </sql>
    </uninstall>

    

    <files folder="site">
        <folder>src</folder>
        <folder>forms</folder>
        <folder>tmpl</folder>
    </files>

  <languages folder="language/site">
    <language tag="ru-RU">com_docstore.ini</language>
  </languages>

    <media destination="com_docstore" folder="media">
        <folder>css</folder>
        <folder>js</folder>
        <filename>joomla.asset.json</filename>
    </media>

    <administration>
        <menu>COM_DOCSTORE</menu>
        <submenu>
			<menu link="option=com_docstore&amp;view=docs" view="docs" alt="Docstore/Docs">COM_DOCSTORE_TITLE_DOCS</menu>
      		<menu link="option=com_categories&amp;extension=com_docstore" view="categories" alt="Docstore/Categories">COM_DOCSTORE_CATEGORIES</menu>
        </submenu>
        <files folder="admin">
            <filename>access.xml</filename>
            <filename>config.xml</filename>
            <folder>forms</folder>
            <folder>src</folder>
            <folder>tmpl</folder>
            <folder>services</folder>
            <folder>presets</folder>
            <folder>sql</folder>
            <folder>vendor</folder>
        </files>
    <languages folder="language/admin">
      <language tag="ru-RU">com_docstore.sys.ini</language>
      <language tag="ru-RU">com_docstore.ini</language>
    </languages>

    </administration>
    

</extension>
