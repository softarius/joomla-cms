<?xml version="1.0" encoding="utf-8"?>
<form>
    <fields name="filter">
        <field name="search" type="text" description="COM_DOCSTORE_SEARCH_FILTER_SUBMIT"
               label="COM_USERS_FILTER_SEARCH_DESC"
               class="js-stools-search-string" />

        <field name="state"
               type="status"
               label="COM_DOCSTORE_FILTER_STATE"
               description="COM_DOCSTORE_FILTER_STATE_DESC"
               onchange="this.form.submit();"
        >
            <option value="">JOPTION_SELECT_PUBLISHED</option>
        </field>

            <field
			name="catid"
			
			type="category"
			extension='com_docstore'
			label="COM_DOCSTORE_CATEGORY_LABEL"
			description="COM_DOCSTORE_CATEGORY_DESC"
             onchange="this.form.submit();"
		>
        <option value="">JOPTION_SELECT_CATEGORY</option>
        </field>

        <field name='format'
        type='sql'
        query="select distinct ext as value from cms_docstore_doc cdd where ext is not null order by 1"
        onchange="this.form.submit();"
        >
        <option value="">-= формат =-</option>
        </field>


        <field name='exists_text'
        type='list'
        label='Наличие текста'
         onchange="this.form.submit();"
        >
        <option value="">-= наличие текста =-</option>
        <option value="true">есть текст</option>
        <option value="false">нет текста</option>
        </field>

    </fields>

    <fields name="list">

        <field name="fullordering"
               type="list"
               label="COM_DOCSTORE_LIST_FULL_ORDERING"
               description="COM_DOCSTORE_LIST_FULL_ORDERING_DESC"
               onchange="this.form.submit();"
               default="a.id DESC"
        >
            <option value="">JGLOBAL_SORT_BY</option>
            <option value="a.id ASC">JGRID_HEADING_ID_ASC</option>
            <option value="a.id DESC">JGRID_HEADING_ID_DESC</option>
            <option value="a.state ASC">JSTATUS_ASC</option>
            <option value="a.state DESC">JSTATUS_DESC</option>
            <option value="a.ordering ASC">JGRID_HEADING_ORDERING_ASC</option>
            <option value="a.ordering DESC">JGRID_HEADING_ORDERING_DESC</option>

        </field>

       <field name="limit"
               type="limitbox"
               label="COM_DOCSTORE_LIST_LIMIT"
               description="COM_DOCSTORE_LIST_LIMIT_DESC"
               class="input-mini"
               default="25"
               onchange="this.form.submit();"
        />

    </fields>

</form>